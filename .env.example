# === Panel Login ===
# WICHTIG: Generiere ein starkes Passwort: openssl rand -base64 24
AUTH_USER=admin
AUTH_PASS=CHANGE-ME-USE-STRONG-PASSWORD

# === Port auf dem das Panel läuft ===
PANEL_PORT=3006

# === Hostname/IP für Unraid WebUI und Icon-Label ===
# Trag hier den Hostnamen oder die IP deines Unraid-Servers ein
# damit Unraid das Icon und die WebUI-Verlinkung korrekt aufloest
PANEL_HOST=192.168.178.60

# === CS2 Server Verbindung ===
CS2_CONTAINER=cs2-modded-server
RCON_HOST=192.168.178.60
RCON_PORT=27015
RCON_PASSWORD=change_me_to_your_cs2_rcon_password

# === Volumes ===
# Host-Pfad zum CS2-Daten-Ordner (für Force Update)
HOST_CS2_DATA_PATH=/mnt/cache/cs2moddedserver
# Container-interner Pfad (muss nicht geändert werden)
CS2_DATA_PATH=/cs2-data

# === GitHub Container Registry (nur für docker-compose.ghcr.yml) ===
# Dein GitHub-Username/-Org in LOWERCASE (z.B. "patriq")
GHCR_OWNER=your-github-username
# Image-Tag: latest, master, v1.3.0, oder sha-abc1234
IMAGE_TAG=latest
